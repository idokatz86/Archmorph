# Production Environment Terraform Variables
# Copy to terraform.tfvars for production deployment

subscription_id  = "00000000-0000-0000-0000-000000000000"
environment      = "prod"
location         = "westeurope"
openai_location  = "eastus"

# Legacy live-stack cutover only. Reviewed production hardening must set both
# enable_production_infra_hardening=true and this value to true in private config.
enable_production_infra_hardening      = false
key_vault_rbac_authorization_enabled   = false

db_admin_username = "example_admin"
db_admin_password = "CHANGE_ME_PRODUCTION_PASSWORD_MIN16"

alert_email  = "ops@example.com"
frontend_url = "https://frontend.example.com"

# Required for reviewed plans; replace with the exact digest built by CI.
backend_container_image = "example.azurecr.io/archmorph-api@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Supply credential values privately; never commit them. Keep this principal
# stable across overlap and cutover revisions.
archmorph_api_key_principal_id         = "example-static-service"
archmorph_api_key_allow_legacy_overlap = false
manage_archmorph_api_key               = true
manage_archmorph_api_key_rotated       = true

redis_capacity = 1  # Standard C1 for production (1GB)

enable_redis_private_endpoint   = true  # Required: prod Redis disables public access
enable_storage_private_endpoint = true  # Required: prod storage uses deny-by-default firewall

enable_dr = true  # Enable disaster recovery
