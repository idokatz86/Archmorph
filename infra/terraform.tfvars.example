# Copy this file to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars to version control.

subscription_id   = "00000000-0000-0000-0000-000000000000"
location          = "northeurope"
project_name      = "archmorph"
environment       = "dev"
acr_sku           = "Basic"
postgres_sku      = "B_Standard_B1ms"
allowed_ip        = "0.0.0.0"
db_admin_username = "your-db-admin"
frontend_url      = "https://your-frontend.azurestaticapps.net"
backend_container_image = "example.azurecr.io/archmorph-api@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Supply archmorph_api_key and optional archmorph_api_key_rotated through
# TF_VAR_* or an approved private secret store. This identifier is not secret
# and must stay stable across rotations.
archmorph_api_key_principal_id         = "example-static-service"
archmorph_api_key_allow_legacy_overlap = false
