{
  "name": "archmorph-frontend",
  "private": true,
  "version": "4.3.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:security-packages && vitest",
    "test:security-packages": "node --test scripts/security-packages.check.mjs",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --ext js,jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,md}\"",
    "generate:api-types": "openapi-typescript ../backend/openapi.json -o src/generated/api-types.d.ts",
    "generate:api-paths": "node scripts/generate-api-paths.mjs ../backend/openapi.json src/generated/api-paths.js",
    "generate:api-artifacts": "npm run generate:api-types && npm run generate:api-paths",
    "generate:api-schema": "cd ../backend && python3 export_openapi.py > openapi.json && cd ../frontend && npm run generate:api-artifacts",
    "check:api-drift": "npm run generate:api-artifacts && git diff --exit-code -- src/generated/api-types.d.ts src/generated/api-paths.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/dagre": "^0.7.54",
    "@xyflow/react": "^12.11.2",
    "dagre": "^0.8.5",
    "dompurify": "^3.4.12",
    "lucide-react": "^1.25.0",
    "prismjs": "^1.29.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "brace-expansion": "file:../vendor/brace-expansion-5.0.8-compat.tgz",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "js-yaml": "file:../vendor/js-yaml-4.3.0.tgz",
    "nanoid": "file:../vendor/nanoid-3.3.16.tgz",
    "openapi-typescript": "^7.8.0",
    "postcss": "file:../vendor/postcss-8.5.20.tgz",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "@redocly/openapi-core": "1.34.7",
    "brace-expansion": "$brace-expansion",
    "js-yaml": "$js-yaml",
    "nanoid": "$nanoid",
    "postcss": "$postcss",
    "undici": "^7.28.0"
  }
}
